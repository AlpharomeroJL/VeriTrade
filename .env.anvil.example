# Copy to .env.local or merge into .env for **local Anvil only** — never commit real keys.
# Keys below are the **default public** Anvil/Hardhat test keys (account 0–2).

# --- Chain ---
# Start: anvil --port 8545
ERC8004_DEV_CHAIN_ID=31337
ERC8004_RPC_URL=http://127.0.0.1:8545

# --- Wallet roles (see docs/evidence/ANVIL_WALLET_ROLES.md) ---
# Deployer (Anvil account #0)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional overrides for forge script LocalProofBundle (defaults match Anvil #1 / #2 if omitted)
# AGENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# VALIDATOR_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# After LocalProofBundle: paste from evidence/latest-local-proof.json / forge logs
# ERC8004_IDENTITY_REGISTRY_ADDRESS=
# ERC8004_ONCHAIN_AGENT_ID=1
# ERC8004_VALIDATION_REGISTRY_ADDRESS=
# ERC8004_REPUTATION_REGISTRY_ADDRESS=

# EIP-712 signing for intents: use **agent** key to match LocalProofBundle adapter owner
# VERITRADE_INTENT_EIP712_VERIFYING_CONTRACT=<adapter from evidence>
# VERITRADE_INTENT_SIGNER_PRIVATE_KEY=<same as AGENT_PRIVATE_KEY / Anvil #1 default>

# Registration JSON optional agentWallet (mirror on-chain metadata if you set this)
# VERITRADE_AGENT_WALLET_PLACEHOLDER=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
