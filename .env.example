PROJECT_NAME=veritrade
APP_ENV=development
LOG_LEVEL=INFO

VERITRADE_WEB_PORT=34110
VERITRADE_API_PORT=34120
VERITRADE_WORKER_PORT=34121
VERITRADE_DB_PORT=34130
VERITRADE_REDIS_PORT=34140

VERITRADE_API_BASE_URL=http://localhost:34120
VERITRADE_WEB_BASE_URL=http://localhost:34110

DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite:///./veritrade.db

POSTGRES_DB=veritrade
POSTGRES_USER=veritrade
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=34130
POSTGRES_URL=

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=34140
REDIS_URL=redis://localhost:34140/0

TRADING_MODE=paper
EXECUTION_PROVIDER=paper
ENABLE_LIVE_TRADING=false
ENABLE_KRAKEN_EXECUTION=false
ENABLE_REDIS=false
ENABLE_DOCKER=true

# Market tape: demo | kraken_public | kraken_cli (soak tests expect kraken_cli + working CLI)
MARKET_DATA_MODE=demo
KRAKEN_MARKET_CLI_BIN=kraken
# Example: kraken public ticker --pair {pair} --json
KRAKEN_MARKET_CLI_TICKER_TEMPLATE=

DEFAULT_SYMBOL=BTCUSD
DEFAULT_STARTING_EQUITY=10000
DEFAULT_MAX_POSITION_NOTIONAL=500
DEFAULT_MAX_DAILY_LOSS=250
DEFAULT_MAX_DRAWDOWN=500
DEFAULT_CONFIDENCE_THRESHOLD=0.55

ENABLE_DEMO_SEED=true
ENABLE_DEMO_RUN_ONCE=true
ENABLE_ACTIVITY_FEED=true
ENABLE_REPLAY_VIEW=true
ENABLE_ARTIFACT_LOGGING=true
ENABLE_RISK_GUARDRAILS=true
ENABLE_REPUTATION_SCORING=false
ENABLE_MULTI_VENUE=false

ARTIFACTS_DIR=./artifacts
DATA_DIR=./data
LOGS_DIR=./logs

VITE_API_BASE_URL=http://localhost:34120
NEXT_PUBLIC_API_BASE_URL=http://localhost:34120

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_API_BASE_URL=

# Challenge alignment (Kraken + trustless-agent narrative)
VERITRADE_AGENT_ID=veritrade-agent-demo
ERC8004_AGENT_URI_STUB=
KRAKEN_CLI_SURFACE_ENABLED=true
KRAKEN_CLI_COMMAND_STUB=kraken

ALLOW_REAL_ORDERS=false
ALLOW_MARGIN=false
ALLOW_LEVERAGE=false
