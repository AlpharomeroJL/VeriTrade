PROJECT_NAME=veritrade
APP_ENV=development
LOG_LEVEL=INFO

VERITRADE_WEB_PORT=34110
VERITRADE_API_PORT=34120
VERITRADE_WORKER_PORT=34121
VERITRADE_DB_PORT=34130
VERITRADE_REDIS_PORT=34140

VERITRADE_API_BASE_URL=http://localhost:34120
VERITRADE_WEB_BASE_URL=http://localhost:34110

DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite:///./veritrade.db

POSTGRES_DB=veritrade
POSTGRES_USER=veritrade
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=34130
POSTGRES_URL=

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=34140
REDIS_URL=redis://localhost:34140/0

TRADING_MODE=paper
EXECUTION_PROVIDER=paper
ENABLE_LIVE_TRADING=false
ENABLE_KRAKEN_EXECUTION=false
ENABLE_REDIS=false
ENABLE_DOCKER=true

# Market tape: demo | kraken_public | kraken_cli (soak tests expect kraken_cli + working CLI)
MARKET_DATA_MODE=demo
KRAKEN_MARKET_CLI_BIN=kraken
# Example: kraken public ticker --pair {pair} --json
KRAKEN_MARKET_CLI_TICKER_TEMPLATE=

DEFAULT_SYMBOL=BTCUSD
DEFAULT_STARTING_EQUITY=10000
DEFAULT_MAX_POSITION_NOTIONAL=500
DEFAULT_MAX_DAILY_LOSS=250
DEFAULT_MAX_DRAWDOWN=500
DEFAULT_CONFIDENCE_THRESHOLD=0.55

ENABLE_DEMO_SEED=true
ENABLE_DEMO_RUN_ONCE=true
ENABLE_ACTIVITY_FEED=true
ENABLE_REPLAY_VIEW=true
ENABLE_ARTIFACT_LOGGING=true
ENABLE_RISK_GUARDRAILS=true
ENABLE_REPUTATION_SCORING=false
ENABLE_MULTI_VENUE=false

ARTIFACTS_DIR=./artifacts
DATA_DIR=./data
LOGS_DIR=./logs

VITE_API_BASE_URL=http://localhost:34120
NEXT_PUBLIC_API_BASE_URL=http://localhost:34120

# --- Public deploy (Vercel web + hosted API) ---
# On the Vercel *web* project, set at least:
#   VITE_API_BASE_URL=https://YOUR_PUBLIC_API_ORIGIN   (no trailing slash)
# Optional overrides for the prebuild registration merge (same as API VERITRADE_* when split):
#   VERITRADE_PUBLIC_WEB_BASE_URL=https://YOUR_PUBLIC_WEB_ORIGIN
#   VERITRADE_PUBLIC_API_BASE_URL=https://YOUR_PUBLIC_API_ORIGIN
# On the *API* host in production, set VERITRADE_WEB_BASE_URL and VERITRADE_API_BASE_URL to those same public HTTPS origins so GET /challenge/agent-registration matches /.well-known.

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_API_BASE_URL=

# Challenge alignment (Kraken + ERC-8004 draft-aligned narrative)
VERITRADE_AGENT_ID=veritrade-agent-demo
ERC8004_AGENT_URI_STUB=
# Optional 0x address — surfaced as registration JSON `agentWallet` when set (not a chain attestation).
# After `LocalProofBundle`, set to the agent owner address (Anvil #1) to align with on-chain `setMetadata("agentWallet",…)`.
VERITRADE_AGENT_WALLET_PLACEHOLDER=

# --- Local / Anvil ERC-8004-style registry binding (optional; see docs/erc8004-alignment.md) ---
# Copy docs: `.env.anvil.example` + `docs/evidence/ANVIL_WALLET_ROLES.md` for role-mapped keys.
# After `forge create` / `cast send` from local-registry/, paste addresses and the minted agent id:
ERC8004_DEV_CHAIN_ID=31337
ERC8004_IDENTITY_REGISTRY_ADDRESS=
ERC8004_ONCHAIN_AGENT_ID=
ERC8004_VALIDATION_REGISTRY_ADDRESS=
ERC8004_REPUTATION_REGISTRY_ADDRESS=
# Optional JSON-RPC (Anvil / testnet) for ERC-1271 eth_call on GET /intents/{id}/signature-verification
# and read-only getValidationStatus / identity reads on GET /challenge/erc8004/onchain-read
ERC8004_RPC_URL=

# --- Public Ethereum Sepolia (operator deploy; see docs/evidence/PUBLIC_SEPOLIA_DEPLOY.md) ---
# ERC8004_DEV_CHAIN_ID=11155111
# ERC8004_RPC_URL=https://ethereum-sepolia.publicnode.com

# Optional: after artifacts of selected types are written, emit validationRequest (default off; requires RPC + keys).
# ERC8004_ARTIFACT_VALIDATION_EMIT_ENABLED=false
# ERC8004_ARTIFACT_VALIDATION_TRIGGER_TYPES=execution,lane_execution
# ERC8004_ARTIFACT_VALIDATION_PRIVATE_KEY=
# ERC8004_ARTIFACT_VALIDATION_VALIDATOR_ADDRESS=
# ERC8004_ARTIFACT_VALIDATION_REGISTRY_ADDRESS=

# Optional second ERC-1271 contract for digest/signature eth_call (e.g. second adapter deploy).
# VERITRADE_EIP1271_SECONDARY_VERIFIER=

# EIP-712 trade intent signing (optional). Use ONLY throwaway keys (e.g. Anvil #0). Never commit real secrets.
VERITRADE_INTENT_EIP712_DOMAIN_NAME=VeriTrade
VERITRADE_INTENT_EIP712_DOMAIN_VERSION=1
VERITRADE_INTENT_EIP712_VERIFYING_CONTRACT=
VERITRADE_INTENT_SIGNER_PRIVATE_KEY=
KRAKEN_CLI_SURFACE_ENABLED=true
KRAKEN_CLI_COMMAND_STUB=kraken

ALLOW_REAL_ORDERS=false
ALLOW_MARGIN=false
ALLOW_LEVERAGE=false
